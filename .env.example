# Copy this file to .env and fill in what applies to you.

# --- ASR ---------------------------------------------------------------
WHISPER_MODEL=small
SAMPLE_RATE=16000

# --- Kaggle F5-TTS GPU endpoint -----------------------------------------
# Fast path: paste the ngrok URL printed by kaggle_server/f5_tts_server.py
# after you start your Kaggle notebook session.
KAGGLE_TTS_URL="https://supervise-armory-sulphate.ngrok-free.dev"

# Optional auto-discovery: a Kaggle Dataset ("username/slug") that the
# notebook keeps updated with its current public URL.
KAGGLE_ENDPOINT_DATASET=

# Optional auto-launch: your Kaggle notebook reference ("username/kernel-slug")
# and API credentials (from kaggle.json), so this app can trigger the
# notebook to run via the Kaggle API with zero browser interaction.
KAGGLE_KERNEL_REF=
KAGGLE_USERNAME=
KAGGLE_KEY=

AUTO_LAUNCH_KAGGLE=true
KAGGLE_HEALTH_TIMEOUT=5
KAGGLE_LAUNCH_WAIT_SECONDS=480
KAGGLE_POLL_INTERVAL_SECONDS=15
TTS_REQUEST_TIMEOUT=180
